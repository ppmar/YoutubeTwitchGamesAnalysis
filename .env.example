# Copy to .env and fill in. Never commit .env.

# YouTube Data API v3 key (single key, single Google Cloud project).
YOUTUBE_API_KEY=

# PostgreSQL connection string.
# Local (docker compose): postgresql+psycopg://ytc:ytc@localhost:5432/ytc
# Railway: reference the Postgres service variable, do not copy the value.
DATABASE_URL=postgresql+psycopg://ytc:ytc@localhost:5432/ytc

# Study to run by default.
YTC_STUDY=battle_royale

# PostgreSQL used by the test suite only. Must be a DIFFERENT service from the one
# above: the tests create and drop objects. Leave empty to skip the PostgreSQL-only
# tests. Use the public proxy URL of the Railway test service.
TEST_DATABASE_URL=
